{
  "name": "hacado",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "prebuild": "turbo run generate-locales && turbo run check-translations && turbo run lint",
    "predev": "turbo run generate-locales",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "typegen": "turbo run typegen",
    "lint": "turbo run lint --",
    "lint:fix": "turbo run lint:fix --",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "migration": "migrate-mongo",
    "migration:up": "migrate-mongo up",
    "migration:add": "migrate-mongo create",
    "migration:new": "migrate-mongo create",
    "migration:down": "migrate-mongo down",
    "purge-organization": "yarn --cwd apps/admin purge-organization",
    "check-translations": "turbo run check-translations --",
    "translate": "turbo run translate --",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "lint-staged": {},
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "migrate-mongo": "^12.1.3",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^4.2.0",
    "turbo": "^2.3.3",
    "typescript": "6.0.2"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=21"
  },
  "resolutions": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "date-fns": "4.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6",
    "sharp": "0.32.6"
  }
}
