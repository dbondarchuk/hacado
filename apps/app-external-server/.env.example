SECRET_KEY="uw8iDFHFNjbIU8gPGMByTLiFfXJex7E1"

# Database Configuration
MONGODB_URI=mongodb://localhost:27017?retryWrites=true&w=majority
MONGODB_DB=hacado

PUBLIC_DOMAIN=hacado.me
ADMIN_DOMAIN=app.hacado.com
APPS_EXTERNAL_DOMAIN=apps.hacado.com

# Stripe Connect webhook signing secret for {APPS_EXTERNAL_URL}/api/webhooks/apps/name/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Square webhook signature key for {APPS_EXTERNAL_URL}/api/webhooks/apps/name/square
SQUARE_APP_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=sandbox

# Platform SMS sender: telnyx (default) or textbelt. Textbelt cannot carry links.
# SMS_PROVIDER=telnyx
# Platform TextBelt API key (HMAC verify for /api/webhooks/platform/textbelt/{orgId})
TEXTBELT_API_KEY=
# Telnyx platform SMS and webhook signature (POST /api/webhooks/platform/telnyx/messaging)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Client toll-free pool. Numbers are shared and stored in sms-pool-numbers.
# TELNYX_CLIENT_MESSAGING_PROFILE_ID=
# Verification status webhook: POST /api/webhooks/platform/telnyx/verification

PAYPAL_ENVIRONMENT=sandbox
