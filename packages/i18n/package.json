{
  "name": "@hacado/i18n",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "type-check": "tsc --pretty --noEmit",
    "type-check:ci": "tsc-absolute --pretty --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate-locales": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-locales-from-yaml.mjs",
    "typegen": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-locales-from-yaml.mjs",
    "check-translations": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-translations.js",
    "translate": "node scripts/translate-missing-locale-keys.js",
    "translate-locale-batch": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/translate-locale-batch.mjs",
    "translate-templates-batch": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/translate-templates-batch.mjs",
    "translate-ts-emails": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/translate-ts-emails.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.tsx",
    "./server": "./src/server.ts",
    "./request": "./src/request.ts",
    "./components": "./src/components.tsx"
  },
  "devDependencies": {
    "@hacado/eslint-config": "*",
    "@hacado/typescript-config": "*",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "next-intl": "^4.13.5",
    "yaml": "^2.7.0"
  }
}
