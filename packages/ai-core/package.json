{
  "name": "@hacado/ai-core",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "type-check": "tsc --pretty --noEmit",
    "type-check:ci": "tsc-absolute --pretty --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider/index.ts",
    "./models": "./src/models/index.ts",
    "./usage": "./src/usage/index.ts",
    "./rate-limit": "./src/rate-limit/index.ts",
    "./image": "./src/image/index.ts",
    "./cache": "./src/cache/index.ts",
    "./business": "./src/business/index.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.146",
    "@ai-sdk/openai": "4.0.118",
    "@hacado/logger": "*",
    "@hacado/types": "*",
    "ai": "7.0.173",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@hacado/eslint-config": "*",
    "@hacado/typescript-config": "*",
    "@types/node": "^20",
    "tsx": "4.19.0",
    "typescript": "6.0.2"
  }
}
