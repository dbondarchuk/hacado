{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn run dev"
    },
    {
      "name": "Next.js: debug admin server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn run dev --filter=@hacado/admin"
    },
    {
      "name": "Next.js: debug web server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn run dev --filter=@hacado/web"
    },
    {
      "name": "Next.js: debug app-external-server server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn run dev --filter=@hacado/app-external-server"
    },
    {
      "name": "Next.js: debug job processor server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn run dev --filter=@hacado/job-processor"
    },
    {
      "name": "Next.js: debug notification sender server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn run dev --filter=@hacado/notification-sender"
    },
    {
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "yarn run dev",
      "cwd": "${workspaceFolder}/apps/web/",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}
