{
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.codeActionsOnSave.rules": ["hacado/padding-lines"],
  "[javascript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "svg.preview.background": "dark-transparent",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next/cache": true,
    "**/.next/server": true,
    "**/.next/static": true,
    "**/.turbo": true,
    "**/coverage": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/cache/**": true,
    "**/.next/server/**": true,
    "**/.next/static/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/*.tsbuildinfo": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next/cache": true,
    "**/.next/server": true,
    "**/.next/static": true,
    "**/.turbo": true,
    "**/coverage": true
  },
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "**/dist",
      "**/build",
      "**/.next/cache",
      "**/.next/server",
      "**/.next/static",
      "**/.turbo",
      "**/coverage"
    ]
  },
  "js/ts.tsserver.log": "off",
  "js/ts.tsserver.maxMemory": 8192,
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}
