{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_RUNTIME",
    "PUBLIC_DOMAIN",
    "ADMIN_DOMAIN",
    "LOG_LEVEL",
    "SECRET_KEY",
    "ORGANIZATION_SLUG",
    "PORT",
    "NODE_ENV",
    "MONGODB_URI",
    "MONGODB_DB",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "BETTER_AUTH_TRUST_HOST",
    "AUTH_TRUST_HOST",
    "BETTER_AUTH_URL",
    "ADMIN_URL",
    "AUTH_SECRET",
    "POLAR_ACCESS_TOKEN",
    "POLAR_SERVER",
    "POLAR_SMS_CREDITS_METER_ID",
    "POLAR_SMS_USAGE_EVENT_NAME",
    "POLAR_WEBHOOK_SECRET",
    "POLAR_SMS_CREDITS_BENEFIT_ID",
    "POLAR_BILLING_PLANS",
    "CUSTOM_DOMAIN_A_RECORD_IP",
    "APPS_EXTERNAL_DOMAIN",
    "APP_EXTERNAL_SERVER_PORT",
    "SMTP_AUTH_USER",
    "SMTP_AUTH_PASS",
    "SMTP_EMAIL",
    "SMTP_FROM_NAME",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_AUTH_PASSWORD",
    "GOOGLE_CALENDAR_APP_CLIENT_ID",
    "GOOGLE_CALENDAR_APP_CLIENT_SECRET",
    "OUTLOOK_APP_CLIENT_ID",
    "OUTLOOK_APP_CLIENT_SECRET",
    "OUTLOOK_APP_TENNANT_ID",
    "ZOOM_APP_CLIENT_ID",
    "ZOOM_APP_CLIENT_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_CONNECT_CLIENT_ID",
    "STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION_TEST",
    "STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION_LIVE",
    "STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION",
    "SQUARE_ENVIRONMENT",
    "SQUARE_APP_ACCESS_TOKEN",
    "SQUARE_APP_APPLICATION_SECRET",
    "SQUARE_APP_APPLICATION_ID",
    "SQUARE_APP_WEBHOOK_SIGNATURE_KEY",
    "PAYPAL_ENVIRONMENT",
    "PAYPAL_ENV",
    "TEXTBELT_API_KEY",
    "BULLMQ_EVENTS_QUEUE_NAME",
    "BULLMQ_EVENTS_CONCURRENCY",
    "BULLMQ_REMOVE_ON_COMPLETE",
    "BULLMQ_REMOVE_ON_FAIL",
    "BULLMQ_MAX_RETRIES",
    "BULLMQ_BACKOFF_TYPE",
    "BULLMQ_BACKOFF_DELAY",
    "BULLMQ_EMAIL_QUEUE_NAME",
    "BULLMQ_EMAIL_CONCURRENCY",
    "BULLMQ_TEXT_MESSAGE_QUEUE_NAME",
    "BULLMQ_TEXT_MESSAGE_CONCURRENCY",
    "BULLMQ_JOB_QUEUE_NAME",
    "BULLMQ_JOB_CONCURRENCY",
    "BULLMQ_RUN_MODE",
    "BULLMQ_MAX_RESTARTS",
    "BULLMQ_RESTART_DELAY",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "REDIS_USERNAME",
    "REDIS_DB",
    "EMAIL_PROVIDER",
    "RESEND_API_KEY",
    "RESEND_EMAIL",
    "RESEND_FROM_NAME",
    "RESEND_CUSTOMER_EMAIL",
    "RESEND_CUSTOMER_FROM_NAME",
    "TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET_KEY",
    "SIGNUP_GEO_BLOCKING_ENABLED",
    "SIGNUP_EMAIL_BLOCKING_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typegen": {
      "dependsOn": ["^typegen"]
    },
    "check-translations": {
      "dependsOn": ["^check-translations"],
      "cache": false
    },
    "generate-locales": {
      "dependsOn": ["^generate-locales"],
      "cache": false
    },
    "translate": {
      "dependsOn": ["^translate"],
      "cache": false
    }
  }
}
